{
  "name": "@aivm/brain",
  "version": "0.3.5",
  "description": "AIVM Brain — one-command install for the governed MCP brain (npx @aivm/brain init).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "aivm-brain": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test src/*.test.ts",
    "build": "tsc -p tsconfig.json && esbuild src/bin.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/bin.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "aivm",
    "mcp",
    "model-context-protocol",
    "ai-governance"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
